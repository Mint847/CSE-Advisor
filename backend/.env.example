# Copy to .env and fill in. All optional except where noted.

# Telegram bot (free): create a bot with @BotFather, then message it once and
# run `python -m cse_advisor.telegram_bot --whoami` to find your chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of the web app for links in Telegram messages (e.g. your Tailscale address)
APP_URL=http://localhost:8000

# Optional pay-per-use LLM narrative (off unless llm.enabled: true in settings.yaml)
ANTHROPIC_API_KEY=

# Database location (default: backend/data/cse_advisor.db)
# DATABASE_URL=sqlite:///./data/cse_advisor.db

# Network: the app has no login, so by default only this PC can open it.
# HOST=0.0.0.0 lets devices on your Wi-Fi reach it (only do this on a trusted network).
# HOST=127.0.0.1
# PORT=8000
