# Copy to .env and fill in. All optional except where noted.

# Telegram bot (free): create a bot with @BotFather, then message it once and
# run `python -m cse_advisor.telegram_bot --whoami` to find your chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of the web app for links in Telegram messages (e.g. your Tailscale address)
APP_URL=http://localhost:8000

# Optional, pay-per-use (about a cent a night): Claude Haiku reads the news headlines. Off unless llm.enabled: true in
# settings.yaml; needs `pip install -e ".[llm]"`. Key from console.anthropic.com (or run `ant auth login` instead).
ANTHROPIC_API_KEY=

# Optional, free: US Federal Reserve data (US 10-year yield, Fed funds, VIX, dollar index, Brent) for the quant pages'
# correlations and regressions. Key from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Where the database, its backups and the study cache live (default: backend/data). Keep this OUT of OneDrive:
# python -m cse_advisor.tools.move_data moves it and sets this line for you.
# CSE_DATA_DIR=C:\Users\you\CSE-Advisor-data
# Or the database alone (default: <data folder>/cse_advisor.db)
# DATABASE_URL=sqlite:///./data/cse_advisor.db

# Accounts / sign-in (README, "Accounts"). Off while FIREBASE_PROJECT_ID is empty: single local user.
# Values from Firebase console > Project settings > Your apps > Web app. They are public (they identify the
# project, they grant no access); no service-account key is needed.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_STORAGE_BUCKET=
# Domain(s) the app is served from, comma-separated: sign-in then runs first-party there (Safari, home-screen apps)
APP_DOMAINS=
# Verified emails that may change shared market data and run jobs (or set the admin custom claim)
ADMIN_EMAILS=
# Shown on the forgot-password page
SUPPORT_EMAIL=
# APP_NAME=CSE Advisor
# Local testing only, with a demo-* project id: FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Network. Without sign-in the app only listens on this PC; HOST=0.0.0.0 then needs ALLOW_NO_AUTH=1 (trusted
# network only). With sign-in on, put it behind HTTPS (reverse proxy or tunnel) and set HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=8000
# ALLOW_NO_AUTH=1
# FORWARDED_ALLOW_IPS=127.0.0.1     # proxies whose X-Forwarded-* headers are trusted
